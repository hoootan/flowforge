# FlowForge Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Encryption key for storing sensitive data (AI provider keys, TOTP secrets)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOWFORGE_ENCRYPTION_KEY=your-encryption-key-here

# Encryption salt for key derivation (unique per installation)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
FLOWFORGE_ENCRYPTION_SALT=your-unique-salt-here

# JWT secret for dashboard authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOWFORGE_JWT_SECRET=your-jwt-secret-here

# =============================================================================
# DATABASE & REDIS
# =============================================================================

# PostgreSQL connection string
FLOWFORGE_DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge

# Redis connection string
FLOWFORGE_REDIS_URL=redis://localhost:6379

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Environment: development, staging, or production
FLOWFORGE_ENV=development

# Server binding
FLOWFORGE_HOST=0.0.0.0
FLOWFORGE_PORT=8000

# Debug mode (never enable in production)
FLOWFORGE_DEBUG=false

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Allowed origins for CORS (comma-separated)
# In production, set this to your frontend domain(s)
# Example: FLOWFORGE_CORS_ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com
FLOWFORGE_CORS_ALLOWED_ORIGINS=

# =============================================================================
# AI PROVIDER API KEYS (Optional - configure as needed)
# =============================================================================

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Google AI API Key
GOOGLE_API_KEY=

# Mistral AI API Key
MISTRAL_API_KEY=

# Cohere API Key
COHERE_API_KEY=

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# Login rate limit (requests per minute per IP)
FLOWFORGE_LOGIN_RATE_LIMIT=10

# Login lockout threshold (failed attempts before lockout)
FLOWFORGE_LOGIN_LOCKOUT_THRESHOLD=5

# Login lockout duration (seconds)
FLOWFORGE_LOGIN_LOCKOUT_DURATION=900

# =============================================================================
# JWT TOKEN CONFIGURATION
# =============================================================================

# Access token expiry (seconds) - default: 1 hour
FLOWFORGE_JWT_DEFAULT_EXPIRY_SECONDS=3600

# Refresh token expiry (seconds) - default: 24 hours
FLOWFORGE_JWT_REFRESH_EXPIRY_SECONDS=86400

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
FLOWFORGE_LOG_LEVEL=INFO

# Log format: json or console
FLOWFORGE_LOG_FORMAT=console
